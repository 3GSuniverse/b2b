#!/usr/bin/env bash
# hayate: run the Hayate server on this VM.
#
#   hayate install           first time: Docker, settings, start everything, nightly backups
#   hayate deploy            get the latest code from GitHub, back up, update, restart
#   hayate status            what's running and whether it's healthy
#   hayate logs [api|worker] follow the logs (Ctrl+C to stop)
#   hayate restart | stop    restart or stop everything
#   hayate backup            back up the database now
#   hayate restore <file>    put a backup back (asks first)
#   hayate plan <owner email> [paid [emails] | trial <days>]
#   hayate feature whatsapp-web <owner email> on|off
set -euo pipefail

DEPLOY_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_DIR="$(dirname "$DEPLOY_DIR")"
ENV_FILE="$DEPLOY_DIR/.env"
BACKUP_DIR="$DEPLOY_DIR/backups"
KEEP_DAYS=14

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
ok() { printf '\033[32m✓\033[0m %s\n' "$*"; }
warn() { printf '\033[33m!\033[0m %s\n' "$*"; }
die() {
  printf '\033[31m✗ %s\033[0m\n' "$*" >&2
  exit 1
}

compose() {
  [[ -f "$ENV_FILE" ]] || die "No settings yet. Run: hayate install"
  docker compose -p hayate -f "$DEPLOY_DIR/docker-compose.yml" --env-file "$ENV_FILE" "$@"
}

env_value() { grep -E "^$1=" "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2- || true; }

wait_healthy() {
  local port url i
  port="$(env_value HAYATE_PORT)"
  url="http://127.0.0.1:${port:-4100}/health"
  for i in $(seq 1 45); do
    if curl -fsS "$url" >/dev/null 2>&1; then
      ok "Healthy: $url"
      return 0
    fi
    sleep 2
  done
  compose ps
  compose logs --tail 60 api worker migrate || true
  die "The app didn't become healthy. The logs above show why."
}

# The app runs as a different user inside the container, so it needs read access to these files.
# The folder can be entered but not listed by others; the VM has a single login anyway.
fix_secrets() {
  [[ -d "$DEPLOY_DIR/secrets" ]] || return 0
  chmod 711 "$DEPLOY_DIR/secrets"
  find "$DEPLOY_DIR/secrets" -type f -exec chmod 644 {} +
}

cmd_install() {
  bold "Installing Hayate on $(hostname)"

  if ! command -v docker >/dev/null 2>&1; then
    bold "Installing Docker (official installer from get.docker.com)…"
    curl -fsSL https://get.docker.com | sudo sh
    sudo usermod -aG docker "$USER" || true
    warn "Docker installed. Log out and back in (or run 'newgrp docker'), then run 'hayate install' again."
    exit 0
  fi
  docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is missing. Install the docker-compose-plugin package."
  ok "Docker is ready"

  # Small VMs (e2-small has 2 GB) run out of memory while building the dashboard without swap
  local mem_mb
  mem_mb="$(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo)"
  if [[ "$mem_mb" -lt 3500 && -z "$(swapon --show 2>/dev/null)" ]]; then
    bold "Adding 2 GB of swap (this VM has ${mem_mb} MB of memory)…"
    sudo fallocate -l 2G /swapfile && sudo chmod 600 /swapfile && sudo mkswap /swapfile >/dev/null && sudo swapon /swapfile
    grep -q '^/swapfile' /etc/fstab || echo '/swapfile none swap sw 0 0' | sudo tee -a /etc/fstab >/dev/null
    ok "Swap added"
  fi

  if [[ ! -f "$ENV_FILE" ]]; then
    cp "$DEPLOY_DIR/.env.example" "$ENV_FILE"
    chmod 600 "$ENV_FILE"
    sed -i "s|^APP_SECRET=.*|APP_SECRET=$(openssl rand -hex 32)|" "$ENV_FILE"
    sed -i "s|^TOKEN_ENCRYPTION_KEY=.*|TOKEN_ENCRYPTION_KEY=$(openssl rand -base64 32)|" "$ENV_FILE"
    sed -i "s|^POSTGRES_PASSWORD=.*|POSTGRES_PASSWORD=$(openssl rand -hex 24)|" "$ENV_FILE"

    read -r -p "Public address [https://campaigns.kurukshetra-travels.in]: " url
    url="${url:-https://campaigns.kurukshetra-travels.in}"
    url="${url%/}"
    sed -i "s|^PUBLIC_URL=.*|PUBLIC_URL=$url|; s|^APP_URL=.*|APP_URL=$url|; s|^GOOGLE_REDIRECT_URI=.*|GOOGLE_REDIRECT_URI=$url/api/integrations/gmail/callback|" "$ENV_FILE"

    read -r -p "Port on this VM for the Cloudflare tunnel [4100]: " port
    sed -i "s|^HAYATE_PORT=.*|HAYATE_PORT=${port:-4100}|" "$ENV_FILE"

    read -r -p "AWS access key ID for SES (Enter to skip; emails will only be printed): " key
    if [[ -n "$key" ]]; then
      read -r -s -p "AWS secret access key: " secret
      echo
      sed -i "s|^AWS_ACCESS_KEY_ID=.*|AWS_ACCESS_KEY_ID=$key|; s|^AWS_SECRET_ACCESS_KEY=.*|AWS_SECRET_ACCESS_KEY=$secret|" "$ENV_FILE"
      read -r -p "SNS topic ARN for bounces (Enter to add later): " arn
      [[ -n "$arn" ]] && sed -i "s|^SES_SNS_TOPIC_ARN=.*|SES_SNS_TOPIC_ARN=$arn|" "$ENV_FILE"
    else
      sed -i "s|^EMAIL_PROVIDER=.*|EMAIL_PROVIDER=log|" "$ENV_FILE"
      warn "No AWS keys: emails won't really be sent. Add them later in $ENV_FILE, then 'hayate restart'."
    fi
    ok "Settings saved to $ENV_FILE (readable only by you)"
  else
    ok "Using existing settings in $ENV_FILE"
  fi

  mkdir -p "$DEPLOY_DIR/secrets" "$BACKUP_DIR"
  chmod 700 "$BACKUP_DIR"
  fix_secrets

  # The 'hayate' command, from anywhere
  sudo ln -sf "$DEPLOY_DIR/hayate" /usr/local/bin/hayate
  ok "The 'hayate' command is installed"

  # Nightly backup at 02:30 server time
  local line="30 2 * * * $DEPLOY_DIR/hayate backup >> $BACKUP_DIR/backup.log 2>&1"
  (crontab -l 2>/dev/null | grep -v 'hayate backup'; echo "$line") | crontab -
  ok "Nightly database backup scheduled (02:30)"

  bold "Building and starting (the first build takes a few minutes)…"
  compose build
  compose up -d
  wait_healthy
  bold "Hayate is running."
  echo "Next: point the Cloudflare tunnel at http://localhost:$(env_value HAYATE_PORT) (see deploy/README.md)."
}

cmd_deploy() {
  bold "Deploying the latest version"
  if git -C "$REPO_DIR" rev-parse --git-dir >/dev/null 2>&1; then
    if [[ -n "$(git -C "$REPO_DIR" status --porcelain --untracked-files=no)" ]]; then
      die "There are local changes to the code on this VM. Commit or discard them first (git -C $REPO_DIR status)."
    fi
    git -C "$REPO_DIR" pull --ff-only
    ok "Code: $(git -C "$REPO_DIR" log -1 --format='%h %s')"
  fi
  if compose ps --status running --services 2>/dev/null | grep -q postgres; then
    cmd_backup
  fi
  fix_secrets
  compose build
  # Migrations run first (the 'migrate' service); the API and worker start only if they succeed
  compose up -d --remove-orphans
  wait_healthy
  docker image prune -f >/dev/null 2>&1 || true
  bold "Deployed."
}

cmd_backup() {
  mkdir -p "$BACKUP_DIR"
  local file
  file="$BACKUP_DIR/hayate-$(date +%Y%m%d-%H%M%S).sql.gz"
  compose exec -T postgres pg_dump -U hayate --no-owner hayate | gzip >"$file"
  [[ -s "$file" ]] || die "Backup came out empty: $file"
  ok "Backup: $file ($(du -h "$file" | cut -f1))"
  find "$BACKUP_DIR" -name 'hayate-*.sql.gz' -mtime +"$KEEP_DAYS" -delete
  local bucket
  bucket="$(env_value BACKUP_BUCKET)"
  if [[ -n "$bucket" ]]; then
    if command -v gcloud >/dev/null 2>&1; then
      gcloud storage cp "$file" "$bucket/" --quiet && ok "Copied to $bucket"
    else
      warn "BACKUP_BUCKET is set but gcloud isn't installed; kept the local copy only"
    fi
  fi
}

cmd_restore() {
  local file="${1:-}"
  [[ -f "$file" ]] || die "Usage: hayate restore deploy/backups/hayate-YYYYMMDD-HHMMSS.sql.gz"
  warn "This replaces ALL current data with the backup from $(basename "$file")."
  read -r -p "Type RESTORE to continue: " answer
  [[ "$answer" == "RESTORE" ]] || die "Cancelled"
  cmd_backup
  compose stop api worker
  compose exec -T postgres psql -U hayate -d postgres -c 'DROP DATABASE IF EXISTS hayate WITH (FORCE);' -c 'CREATE DATABASE hayate OWNER hayate;'
  gunzip -c "$file" | compose exec -T postgres psql -q -U hayate -d hayate
  compose up -d
  wait_healthy
  ok "Restored from $(basename "$file")"
}

case "${1:-help}" in
  install) cmd_install ;;
  deploy) cmd_deploy ;;
  status)
    compose ps
    curl -fsS "http://127.0.0.1:$(env_value HAYATE_PORT)/health" && echo
    ;;
  logs)
    shift
    compose logs -f --tail 100 "${@:-api worker}"
    ;;
  restart)
    fix_secrets
    compose up -d --force-recreate api worker
    wait_healthy
    ;;
  stop) compose stop ;;
  backup) cmd_backup ;;
  restore)
    shift
    cmd_restore "${1:-}"
    ;;
  plan)
    shift
    compose exec -T api node dist/cli/plan.js "$@"
    ;;
  feature)
    shift
    compose exec -T api node dist/cli/feature.js "$@"
    ;;
  *)
    sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
