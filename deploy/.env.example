# Production settings for the Drona server. `drona install` creates deploy/.env from this
# file and fills in the secrets. Keep deploy/.env on the server only: never commit it.

# --- Where the app lives ---------------------------------------------------
# The public address (the Cloudflare hostname). Used for unsubscribe links and Google sign-in.
PUBLIC_URL=https://dhrona.kurukshetra-travels.in
APP_URL=https://dhrona.kurukshetra-travels.in
# Optional: a neutral web address for the links customers get (payment, quote, receipt,
# unsubscribe), e.g. https://go.yourneutraldomain.in. Agencies' customers then never see the
# platform's own domain. Point it at the same tunnel; only customer pages work on it.
# LINKS_URL=https://go.yourneutraldomain.in
# Port on this VM that the Cloudflare tunnel points to (only reachable from the VM itself)
DRONA_PORT=4100

# --- Secrets (generated by `drona install`; changing them signs everyone out) ---
APP_SECRET=
TOKEN_ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# --- Amazon SES (email) ------------------------------------------------------
# "ses" sends for real. "log" only prints emails (use it to try the app first).
EMAIL_PROVIDER=ses
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=drona-events
# The SNS topic that delivers bounces and complaints (from the SES setup)
SES_SNS_TOPIC_ARN=
# SES sandbox allows 1 a second; raise after production access (check your SES account limit)
SEND_RATE_PER_SECOND=1

# --- "Connect Gmail" (optional) -------------------------------------------------
# Put the client_secret JSON from Google Cloud in deploy/secrets/google-oauth.json
GOOGLE_OAUTH_JSON=/etc/drona/google-oauth.json
GOOGLE_REDIRECT_URI=https://dhrona.kurukshetra-travels.in/api/integrations/gmail/callback

# --- "Draft with AI" in quotes (optional) ---------------------------------------
# An API key from either Anthropic (console.anthropic.com) or OpenAI (platform.openai.com).
# These are paid separately from any ChatGPT or Claude app subscription. Without a key the button is hidden.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# With both keys set, choose one: anthropic or openai
# AI_PROVIDER=openai
# Quote drafts: claude-sonnet-5-5 (Anthropic) or gpt-5-mini (OpenAI)
# AI_MODEL=
# WhatsApp reply suggestions are short, so they use a cheaper model: claude-haiku-5-5 or gpt-5-mini
# AI_REPLY_MODEL=
# Most AI answers across ALL agencies in 24 hours, then AI pauses for everyone. Your safety net on the bill.
# AI_GLOBAL_PER_DAY=300
# Drona AI answers a day on the free trial (paid plans get theirs from the plan)
# TRIAL_AI_PER_DAY=30

# --- Free trial -----------------------------------------------------------------
TRIAL_DAYS=15
TRIAL_WHATSAPP_PER_DAY=100
TRIAL_EMAILS=200

# --- Backups (optional) -----------------------------------------------------
# A Google Cloud Storage bucket for off-server copies of the nightly backup, e.g. gs://kt-drona-backups
BACKUP_BUCKET=

# Plan & billing: agencies pay for Dhrona through the platform's own Razorpay account
# (Dashboard → Account & Settings → API Keys). Test keys start rzp_test_, live keys rzp_live_.
# Leave empty to keep online payment off.
BILLING_RAZORPAY_KEY_ID=
BILLING_RAZORPAY_KEY_SECRET=
# Optional, recommended: Dashboard → Webhooks → add https://<your address>/webhooks/razorpay-billing
# with the events payment.captured and order.paid, and paste the secret you chose here.
BILLING_RAZORPAY_WEBHOOK_SECRET=
# GST added on top of plan prices, in percent. Leave 0 until you're GST-registered.
BILLING_GST_PERCENT=0
