# Production settings for the Hayate server. `hayate install` creates deploy/.env from this
# file and fills in the secrets. Keep deploy/.env on the server only: never commit it.

# --- Where the app lives ---------------------------------------------------
# The public address (the Cloudflare hostname). Used for unsubscribe links and Google sign-in.
PUBLIC_URL=https://campaigns.kurukshetra-travels.in
APP_URL=https://campaigns.kurukshetra-travels.in
# Port on this VM that the Cloudflare tunnel points to (only reachable from the VM itself)
HAYATE_PORT=4100

# --- Secrets (generated by `hayate install`; changing them signs everyone out) ---
APP_SECRET=
TOKEN_ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# --- Amazon SES (email) ------------------------------------------------------
# "ses" sends for real. "log" only prints emails (use it to try the app first).
EMAIL_PROVIDER=ses
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=sandesh-events
# The SNS topic that delivers bounces and complaints (from the SES setup)
SES_SNS_TOPIC_ARN=
# SES sandbox allows 1 a second; raise after production access (check your SES account limit)
SEND_RATE_PER_SECOND=1

# --- "Connect Gmail" (optional) -------------------------------------------------
# Put the client_secret JSON from Google Cloud in deploy/secrets/google-oauth.json
GOOGLE_OAUTH_JSON=/etc/hayate/google-oauth.json
GOOGLE_REDIRECT_URI=https://campaigns.kurukshetra-travels.in/api/integrations/gmail/callback

# --- Free trial -----------------------------------------------------------------
TRIAL_DAYS=5
TRIAL_WHATSAPP_PER_DAY=100
TRIAL_EMAILS=200

# --- Backups (optional) -----------------------------------------------------
# A Google Cloud Storage bucket for off-server copies of the nightly backup, e.g. gs://kt-hayate-backups
BACKUP_BUCKET=
