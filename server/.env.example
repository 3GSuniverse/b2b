# --- App ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public URL of the dashboard/API (used for unsubscribe + tracking links)
PUBLIC_URL=http://localhost:4000
# Long random string — used to sign sessions and unsubscribe tokens
APP_SECRET=change-me-to-a-long-random-string

# --- Database & queue ---------------------------------------------------
DATABASE_URL=postgresql://sandesh:sandesh@localhost:5432/sandesh
REDIS_URL=redis://localhost:6379

# --- Amazon SES ---------------------------------------------------------
AWS_REGION=ap-south-1
# Keys of the IAM user that can ONLY send email (never root keys)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Configuration set that routes bounce/complaint events to our webhook
SES_CONFIGURATION_SET=sandesh-events

# --- Sending safety -----------------------------------------------------
# Max emails per second this server sends (SES sandbox allows 1/s)
SEND_RATE_PER_SECOND=1
